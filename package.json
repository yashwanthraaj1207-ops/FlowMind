{
  "name": "flowmind",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "electron": "electron electron/main.cjs",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron electron/main.cjs\"",
    "electron:build": "npm run build && electron electron/main.cjs",
    "bridge": "node server/telemetryBridge.js",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "npx tsx src/features/intelligence/engineValidation.ts && npx tsx src/features/intervention/interventionValidation.ts && npx tsx src/features/recommendations/recommendationValidation.ts && npx tsx src/features/analytics/analyticsValidation.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.5",
    "electron": "^44.2.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.6.3",
    "vite": "^6.0.1",
    "wait-on": "^9.1.0"
  }
}
